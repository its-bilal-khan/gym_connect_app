# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
*.env
**/.env
**/*.env
!.env.example
!**/.env.example

# Android Keystores & Signing Keys
**/key.properties
**/*.keystore
**/*.jks

# ------------------------------------------------------------------------------
# Flutter & Dart Build Artifacts & Tooling
# ------------------------------------------------------------------------------
**/.dart_tool/
**/build/
**/coverage/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/.packages
**/doc/api/

# Symbolication & Obfuscation
**/*.symbols
**/*.map.json

# Widget Preview
**/.widget_preview/

# ------------------------------------------------------------------------------
# Android Artifacts & Caches
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/.kotlin/
**/android/local.properties
**/android/captures/
**/android/.cxx/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
**/*.apk
**/*.aab

